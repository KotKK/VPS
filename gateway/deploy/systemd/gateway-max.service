[Unit]
Description=AmneziaWG MAX management webhook
After=network-online.target gateway-web.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/awg-gateway
EnvironmentFile=/etc/awg-gateway/secrets.env
UMask=0077
ExecStart=/opt/awg-gateway/.venv/bin/python -m uvicorn gateway.app.max_webhook:production_app --factory --host 127.0.0.1 --port 8081 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=65
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/awg-gateway
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
