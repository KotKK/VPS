[Unit]
Description=AmneziaWG gateway control panel (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/awg-gateway
EnvironmentFile=/etc/awg-gateway/secrets.env
ExecStart=/opt/awg-gateway/.venv/bin/uvicorn gateway.app.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/awg-gateway /etc/amnezia /etc/systemd/system /run/awg-gateway

[Install]
WantedBy=multi-user.target
